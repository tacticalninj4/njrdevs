{{ $items := slice }}
{{ range site.RegularPages }}
{{ if ne .Layout "search" }}
{{ $items = $items | append (dict
  "title" .Title
  "href" .RelPermalink
  "section" .Section
  "tags" (delimit .Params.tags " ")
  "summary" (.Summary | plainify | truncate 180)
) }}
{{ end }}
{{ end }}
{{ $items | jsonify }}
